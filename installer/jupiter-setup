# ----------------------------------------------------------------- system helpers
def run(cmd: list[str], timeout: float = 20) -> str:
    """Run a command and return stdout ('' on any failure)."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return result.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def call(cmd: list[str], timeout: float = 60) -> bool:
    """Run a command and report whether it exited successfully."""
    try:
        return subprocess.run(cmd, capture_output=True, timeout=timeout, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def is_uefi() -> bool:
    return DEMO or Path("/sys/firmware/efi").is_dir()


def online() -> bool:
    """True when archlinux.org is reachable (wired or wireless)."""
    if DEMO:
        return DEMO_STATE["online"]
    try:
        result = subprocess.run(
            ["curl", "-fsS", "-m", "6", "-o", "/dev/null", "https://archlinux.org"],
            capture_output=True,
            timeout=12,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def wifi_networks() -> list[tuple[str, int, str]]:
    """Return (ssid, signal, security) tuples, strongest first, de-duplicated."""
    if DEMO:
        return [("HomeNet-5G", 82, "WPA2"), ("CoffeeShop", 55, "WPA2"), ("Guest", 30, "")]
    out = run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes"], timeout=40)
    networks: dict[str, tuple[str, int, str]] = {}
    for line in out.splitlines():
        parts = re.split(r"(?<!\\):", line)
        if len(parts) < 3:
            continue
        ssid = parts[0].replace("\\:", ":").strip()
        if not ssid:
            continue
        try:
            signal = int(parts[1])
        except ValueError:
            signal = 0
        security = parts[2].replace("\\:", ":").strip()
        if ssid not in networks or signal > networks[ssid][1]:
            networks[ssid] = (ssid, signal, security)
    return sorted(networks.values(), key=lambda net: -net[1])


@dataclass
class Disk:
    path: str
    size: int
    model: str

    @property
    def label(self) -> str:
        gib = self.size / 1024**3
        return f"{self.path:<16} {gib:>7.0f} GiB   {self.model}"


def live_disk() -> str:
    """The disk the live medium is booted from (never offered as install target)."""
    source = run(["findmnt", "-n", "-o", "SOURCE", "/run/archiso/bootmnt"]).strip()
    if not source:
        return ""
    parent = run(["lsblk", "-no", "PKNAME", source]).strip().splitlines()
    name = parent[0] if parent and parent[0] else os.path.basename(source)
    return f"/dev/{name}"


def install_disks() -> list[Disk]:
    if DEMO:
        return [
            Disk("/dev/nvme0n1", 512 * 1024**3, "Samsung SSD 980"),
            Disk("/dev/sda", 256 * 1024**3, "ATA VBOX HARDDISK"),
        ]
    try:
        devices = json.loads(run(["lsblk", "-J", "-d", "-b", "-o", "NAME,PATH,SIZE,MODEL,TYPE,RO"])).get(
            "blockdevices", []
        )
    except json.JSONDecodeError:
        return []
    boot_disk = live_disk()
    disks = []
    for dev in devices:
        path = dev.get("path") or ""
        if dev.get("type") != "disk" or dev.get("ro") in (True, "1"):
            continue
        if not path or path == boot_disk or path.startswith(("/dev/loop", "/dev/sr", "/dev/zram")):
            continue
        size = int(dev.get("size") or 0)
        if size < MIN_DISK_BYTES:
            continue
        disks.append(Disk(path, size, (dev.get("model") or "Unknown model").strip()))
    return disks


def nvidia_present() -> bool:
    if DEMO:
        return os.environ.get("JUPITER_DEMO_NVIDIA") == "1"
    return any(
        "nvidia" in line.lower() and ("vga" in line.lower() or "3d controller" in line.lower())
        for line in run(["lspci"]).splitlines()
    )


# ----------------------------------------------------------------- state
@dataclass
class Answers:
    hostname: str = "jupiter"
    fullname: str = ""
    username: str = ""
    password: str = ""
    disk: str = ""
    driver: str = "mesa"  # "mesa" or "nvidia"

    def write(self, path: Path) -> None:
        """Write a sourceable env file readable only by root (contains the password)."""
        from shlex import quote

        path.parent.mkdir(parents=True, exist_ok=True)
        fields = {
            "JUP_HOSTNAME": self.hostname,
            "JUP_FULLNAME": self.fullname,
            "JUP_USERNAME": self.username,
            "JUP_PASSWORD": self.password,
            "JUP_DISK": self.disk,
            "JUP_DRIVER": self.driver,
        }
        content = "".join(f"{key}={quote(value)}\n" for key, value in fields.items())
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(content)


# ----------------------------------------------------------------- shared layout
# Keyboard model: the arrow keys (and Tab / Shift+Tab) move between controls on every screen.
# Inside a choice list, up/down pick an option and move on past its first or last entry.
class Card(VerticalScroll):
    """Screen body. Not focusable itself, so the arrow keys move between controls instead of scrolling it."""

    can_focus = False
    BINDINGS = [
        Binding("up,left", "app.focus_previous", show=False),
        Binding("down,right", "app.focus_next", show=False),
    ]


class ChoiceSet(RadioSet):
    """Radio list: arrows select the option directly and leave the list at either end."""

    BINDINGS = [
        Binding("up,left", "step(-1)", show=False),
        Binding("down,right", "step(1)", show=False),
    ]

    def action_step(self, step: int) -> None:
        options = list(self.query(RadioButton))
        current = self.pressed_index
        if current < 0:
            target = 0 if step > 0 else len(options) - 1
        else:
            target = current + step
        if 0 <= target < len(options):
            options[target].value = True
        elif step > 0:
            self.app.action_focus_next()
        else:
            self.app.action_focus_previous()


class ChoiceSelect(Select):
    """Dropdown: Enter opens the list, the arrow keys move between controls."""

    BINDINGS = [
        Binding("up", "app.focus_previous", show=False),
        Binding("down", "app.focus_next", show=False),
    ]


def card(*widgets, **kwargs) -> Card:
    return Card(*widgets, id="card", **kwargs)


def buttons(*widgets) -> Horizontal:
    return Horizontal(*widgets, classes="buttons")


class JupiterScreen(Screen):
    """Base screen: header, card body, footer."""

    STEP = 0
    TOTAL = 6
    TITLE_TEXT = ""
    SUBTITLE_TEXT = ""
    CARD_CLASS = ""

    def frame(self, *body: object) -> ComposeResult:
        yield Header(show_clock=False)
        yield Static(
            f"Step {self.STEP} of {self.TOTAL}   ·   arrows or Tab: move   ·   Enter: select",
            classes="step",
        )
        with card(classes=self.CARD_CLASS):
            yield Static(self.TITLE_TEXT, classes="title")
            yield Static(self.SUBTITLE_TEXT, classes="subtitle")
            yield from body
        yield Footer()

    def back(self) -> None:
        self.app.pop_screen()


# ----------------------------------------------------------------- screens
class WelcomeScreen(JupiterScreen):
    STEP = 1
    AUTO_FOCUS = "#begin"  # never start on Quit: Enter must not exit by accident
    TITLE_TEXT = "Welcome to Jupiter Linux"
    SUBTITLE_TEXT = "A minimal, fast KDE Plasma desktop on Arch Linux."

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)
        with card():
            yield Static(Text(LOGO_ART), classes="logo")
            yield Static("Welcome to [b]Jupiter Linux[/b]", classes="title")
            yield Static("A minimal, fast KDE Plasma desktop on Arch Linux.", classes="subtitle")
            if not is_uefi():
                yield Static("This installer needs a UEFI system. Boot the ISO in UEFI mode.", classes="error")
            yield Static(
                "You will set up: network (only if needed) · disk · user · GPU driver",
                classes="hint",
            )
            yield buttons(
                Button("Quit", id="quit"),
                Button("Begin", id="begin", variant="success", disabled=not is_uefi()),
            )
        yield Footer()

    @on(Button.Pressed, "#quit")
    def quit_app(self) -> None:
        self.app.exit()

    @on(Button.Pressed, "#begin")
    def begin(self) -> None:
        self.check_network()

    @work(thread=True, exclusive=True)
    def check_network(self) -> None:
        if online():
            self.app.call_from_thread(self.app.push_screen, DiskScreen())
        else:
            self.app.call_from_thread(self.app.push_screen, NetworkScreen())


class NetworkScreen(JupiterScreen):
    STEP = 2
    TITLE_TEXT = "Network connection"
    SUBTITLE_TEXT = "No wired connection detected. Connect to Wi-Fi to continue."

    def compose(self) -> ComposeResult:
        yield from self.frame(
            Static("Scanning for Wi-Fi networks…", id="status", classes="hint"),
            ChoiceSelect([], prompt="Choose a network", id="ssid", allow_blank=True),
            Input(password=True, placeholder="Wi-Fi password (empty for open networks)", id="wifi-pass"),
            buttons(
                Button("Back", id="back"),
                Button("Rescan", id="rescan"),
                Button("Connect", id="connect", variant="primary"),
                Button("Continue", id="continue", variant="success", disabled=True),
            ),
        )

    def on_mount(self) -> None:
        self.scan()

    @work(thread=True, exclusive=True)
    def scan(self) -> None:
        networks = wifi_networks()
        self.app.call_from_thread(self._fill, networks)

    def _fill(self, networks: list[tuple[str, int, str]]) -> None:
        select = self.query_one("#ssid", Select)
        select.set_options([(f"{ssid}  ·  {signal}%  ·  {sec or 'open'}", ssid) for ssid, signal, sec in networks])
        status = f"{len(networks)} network(s) found." if networks else "No Wi-Fi networks found. Try Rescan."
        self.query_one("#status", Static).update(status)

    def set_status(self, text: str) -> None:
        self.query_one("#status", Static).update(text)

    @on(Button.Pressed, "#back")
    def on_back(self) -> None:
        self.back()

    @on(Button.Pressed, "#rescan")
    def on_rescan(self) -> None:
        self.set_status("Scanning for Wi-Fi networks…")
        self.scan()

    @on(Button.Pressed, "#continue")
    def on_continue(self) -> None:
        self.app.push_screen(DiskScreen())

    @on(Button.Pressed, "#connect")
    def on_connect(self) -> None:
        ssid = self.query_one("#ssid", Select).value
        if ssid is Select.BLANK:
            self.set_status("Choose a network first.")
            return
        password = self.query_one("#wifi-pass", Input).value
        self.set_status(f"Connecting to {ssid}…")
        self.query_one("#connect", Button).disabled = True
        self.connect(str(ssid), password)

    @work(thread=True, exclusive=True)
    def connect(self, ssid: str, password: str) -> None:
        if DEMO:
            DEMO_STATE["online"] = True
            ok = True
        else:
            cmd = ["nmcli", "--wait", "40", "device", "wifi", "connect", ssid]
            if password:
                cmd += ["password", password]
            ok = call(cmd, timeout=60) and online()
        self.app.call_from_thread(self._connected, ok, ssid)

    def _connected(self, ok: bool, ssid: str) -> None:
        self.query_one("#connect", Button).disabled = False
        if ok:
            self.set_status(f"Connected to {ssid}. Internet is reachable.")
            self.query_one("#continue", Button).disabled = False
        else:
            self.set_status(f"Could not connect to {ssid}. Check the password and try again.")


class DiskScreen(JupiterScreen):
    STEP = 3
    TITLE_TEXT = "Install disk"
    SUBTITLE_TEXT = "Jupiter will be installed on the disk you select. Everything on it will be erased."

    def __init__(self) -> None:
        super().__init__()
        self.disks = install_disks()

    def compose(self) -> ComposeResult:
        if self.disks:
            options = [RadioButton(disk.label, value=(i == 0)) for i, disk in enumerate(self.disks)]
            body = [ChoiceSet(*options, id="disks")]
        else:
            body = [Static("No suitable disk found (at least 8 GiB required).", classes="error")]
        yield from self.frame(
            *body,
            buttons(
                Button("Back", id="back"),
                Button("Continue", id="continue", variant="success", disabled=not self.disks),
            ),
        )

    @on(Button.Pressed, "#back")
    def on_back(self) -> None:
        self.back()

    @on(Button.Pressed, "#continue")
    def on_continue(self) -> None:
        index = self.query_one("#disks", ChoiceSet).pressed_index
        if index < 0:
            return
        self.app.answers.disk = self.disks[index].path
        self.app.push_screen(UserScreen())


def labelled(label: str, widget: Input) -> Input:
    """Put the field label in the input's border, which saves a line per field on short consoles."""
    widget.border_title = label
    return widget


class UserScreen(JupiterScreen):
    STEP = 4
    CARD_CLASS = "compact"  # 80x24 consoles: this form must fit without scrolling
    TITLE_TEXT = "Your account"
    SUBTITLE_TEXT = "Create the user you will log in with. This user gets sudo rights."

    def compose(self) -> ComposeResult:
        yield from self.frame(
            Horizontal(
                labelled("Computer name", Input("jupiter", id="hostname", placeholder="jupiter")),
                labelled("Full name (optional)", Input(id="fullname", placeholder="Ada Lovelace")),
                classes="row first",
            ),
            labelled("Username", Input(id="username", placeholder="ada", classes="gap")),
            Horizontal(
                labelled("Password", Input(password=True, id="password")),
                labelled("Repeat password", Input(password=True, id="password2")),
                classes="row",
            ),
            Static("", id="error", classes="error"),
            buttons(
                Button("Back", id="back"),
                Button("Continue", id="continue", variant="success"),
            ),
        )

    @on(Button.Pressed, "#back")
    def on_back(self) -> None:
        self.back()

    def validate(self) -> str | None:
        hostname = self.query_one("#hostname", Input).value.strip()
        username = self.query_one("#username", Input).value.strip()
        password = self.query_one("#password", Input).value
        password2 = self.query_one("#password2", Input).value
        if not HOSTNAME_RE.match(hostname):
            return "Computer name: letters, digits and hyphens only (max 63)."
        if not USERNAME_RE.match(username) or username == "root":
            return "Username: lowercase letters, digits, '-' or '_', starting with a letter or '_'."
        if len(password) < 6:
            return "Password must be at least 6 characters."
        if password != password2:
            return "The two passwords do not match."
        return None

    @on(Button.Pressed, "#continue")
    def on_continue(self) -> None:
        error = self.validate()
        self.query_one("#error", Static).update(error or "")
        if error:
            return
        answers = self.app.answers
        answers.hostname = self.query_one("#hostname", Input).value.strip()
        answers.fullname = self.query_one("#fullname", Input).value.strip()
        answers.username = self.query_one("#username", Input).value.strip()
        answers.password = self.query_one("#password", Input).value
        self.app.push_screen(DriverScreen())


class DriverScreen(JupiterScreen):
    STEP = 5
    TITLE_TEXT = "Graphics driver"
    SUBTITLE_TEXT = "Choose the driver stack for your GPU."

    def compose(self) -> ComposeResult:
        nvidia = nvidia_present()
        self.app.answers.driver = "nvidia" if nvidia else "mesa"
        hint = (
            "NVIDIA GPU detected: NVIDIA Open is recommended."
            if nvidia
            else "No NVIDIA GPU detected. Mesa is recommended for AMD and Intel."
        )
        yield from self.frame(
            Static(hint, classes="hint"),
            ChoiceSet(
                RadioButton(
                    "Mesa  -  open-source drivers for AMD, Intel and generic GPUs",
                    value=not nvidia,
                    id="drv-mesa",
                ),
                RadioButton(
                    "NVIDIA Open  -  NVIDIA open kernel modules (Turing / RTX 20-series and newer)",
                    value=nvidia,
                    id="drv-nvidia",
                ),
                id="driver",
            ),
            buttons(
                Button("Back", id="back"),
                Button("Continue", id="continue", variant="success"),
            ),
        )

    @on(Button.Pressed, "#back")
    def on_back(self) -> None:
        self.back()

    @on(Button.Pressed, "#continue")
    def on_continue(self) -> None:
        button = self.query_one("#driver", ChoiceSet).pressed_button
        self.app.answers.driver = "nvidia" if button is not None and button.id == "drv-nvidia" else "mesa"
        self.app.push_screen(ReviewScreen())


class ReviewScreen(JupiterScreen):
    STEP = 6
    TITLE_TEXT = "Review"
    SUBTITLE_TEXT = "Check your choices. Installation erases the selected disk."

    def compose(self) -> ComposeResult:
        a = self.app.answers
        driver = "Mesa" if a.driver == "mesa" else "NVIDIA Open kernel modules"
        user = a.username + (f" ({a.fullname})" if a.fullname else "")
        rows = [
            ("Disk", f"{a.disk}  [red](will be erased)[/red]"),
            ("Computer", a.hostname),
            ("User", user),
            ("Graphics", driver),
            ("Desktop", "KDE Plasma (minimal), Zen Browser, paru"),
        ]
        summary = "\n".join(f"[b]{label:<12}[/b]{value}" for label, value in rows)
        yield from self.frame(
            Static(summary, classes="summary"),
            Static("Type ERASE to confirm:", classes="field"),
            Input(placeholder="ERASE", id="confirm"),
            buttons(
                Button("Back", id="back"),
                Button("Erase and install", id="install", variant="error", disabled=True),
            ),
        )

    @on(Input.Changed, "#confirm")
    def on_confirm_changed(self, event: Input.Changed) -> None:
        self.query_one("#install", Button).disabled = event.value != "ERASE"

    @on(Button.Pressed, "#back")
    def on_back(self) -> None:
        self.back()

    @on(Button.Pressed, "#install")
    def on_install(self) -> None:
        self.app.push_screen(InstallScreen())


class InstallScreen(JupiterScreen):
    STEP = 6
    TITLE_TEXT = "Installing Jupiter Linux"
    SUBTITLE_TEXT = "This takes a few minutes. Do not power off the machine."

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)
        with card():
            yield Static(self.TITLE_TEXT, classes="title")
            yield Static("Starting…", id="step-label", classes="subtitle")
            yield ProgressBar(total=100, show_eta=False, id="progress")
            yield Log(id="log", max_lines=2000)
            yield Static("", id="result", classes="hint")
            yield buttons(
                Button("Reboot", id="reboot", variant="success", disabled=True),
                Button("Stay in live session", id="exit", disabled=True),
            )
        yield Footer()

    def on_mount(self) -> None:
        self.app.answers.write(ANSWERS_FILE)
        self.run_installer()

    @work(exclusive=True)
    async def run_installer(self) -> None:
        log = self.query_one("#log", Log)
        progress = self.query_one("#progress", ProgressBar)
        label = self.query_one("#step-label", Static)
        if DEMO:
            command = ["bash", "-c", "for i in 1 2 3 4; do echo \"::STEP $i/4 Demo step $i\"; echo \"  working…\"; sleep 0.6; done; echo DEMO_DONE"]
        else:
            command = [INSTALLER, "--answers", str(ANSWERS_FILE)]
        env = dict(os.environ, JUP_DRY_RUN="1" if DRY_RUN else "0")
        try:
            proc = await asyncio.create_subprocess_exec(
                *command, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT, env=env
            )
        except OSError as exc:
            log.write_line(f"Could not start installer: {exc}")
            self.finish(1)
            return
        assert proc.stdout is not None
        async for raw in proc.stdout:
            line = raw.decode(errors="replace").rstrip()
            log.write_line(line)
            match = re.match(r"::STEP (\d+)/(\d+) (.*)", line)
            if match:
                current, total, text = int(match.group(1)), int(match.group(2)), match.group(3)
                progress.update(total=total, progress=current - 1)
                label.update(f"Step {current}/{total}: {text}")
        code = await proc.wait()
        if code == 0:
            progress.update(total=100, progress=100)
        self.finish(code)

    def finish(self, code: int) -> None:
        result = self.query_one("#result", Static)
        if code == 0:
            self.query_one("#step-label", Static).update("Installation complete.")
            result.update("[green]Jupiter Linux is installed. Remove the USB stick, then reboot.[/green]")
            self.query_one("#reboot", Button).disabled = False
        else:
            self.query_one("#step-label", Static).update("Installation failed.")
            result.update(
                f"[red]The installer exited with code {code}. See /var/log/jupiter-install.log.[/red]"
            )
        self.query_one("#exit", Button).disabled = False

    @on(Button.Pressed, "#reboot")
    def on_reboot(self) -> None:
        self.app.reboot_requested = True
        self.app.exit()

    @on(Button.Pressed, "#exit")
    def on_exit(self) -> None:
        self.app.exit()


