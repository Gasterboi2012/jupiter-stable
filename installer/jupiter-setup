INSTALLER = "/usr/bin/jupiter-install"
ANSWERS_DIR = Path("/run/jupiter")
ANSWERS_FILE = ANSWERS_DIR / "answers.env"
MIN_DISK_BYTES = 8 * 1024**3
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,30}$")
HOSTNAME_RE = re.compile(r"^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")

DEMO = os.environ.get("JUPITER_DEMO") == "1"
DRY_RUN = os.environ.get("JUPITER_DRY_RUN") == "1"
DEMO_STATE = {"online": os.environ.get("JUPITER_DEMO_ONLINE") == "1"}

# Placeholder logo: replace with the real Jupiter artwork later.
LOGO_ART = "\n".join(
    [
        "        .-----.",
        "      .'   *   '.",
        "     /  JUPITER  \\",
        "    |  \\[ LOGO ]  |",
