#!/usr/bin/env python3
"""Jupiter Linux guided installer (TUI).

Runs on the live ISO (tty1). It walks the user through:
  welcome -> network (skipped when already online) -> disk -> user
  -> GPU driver (Mesa or NVIDIA Open) -> review -> install

The collected answers are written to /run/jupiter/answers.env and handed to
/usr/bin/jupiter-install, which performs the actual installation.

Environment variables (for testing):
  JUPITER_DEMO=1          Use fake disks/networks instead of real hardware.
  JUPITER_DEMO_ONLINE=1   Demo mode only: start out online (skips network step).
  JUPITER_DEMO_NVIDIA=1   Demo mode only: pretend an NVIDIA GPU is present.
  JUPITER_DRY_RUN=1       Ask jupiter-install to print commands instead of running them.
"""
from __future__ import annotations

